# --- Base de données (Neon en production) ---
# Chaîne de connexion PostgreSQL. Neon : utiliser l'URL "pooled" pour l'API.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
# false pour une base locale sans TLS (Docker)
DATABASE_SSL=true
# Schéma PostgreSQL (public par défaut ; les tests e2e utilisent welly_test)
DATABASE_SCHEMA=public

# --- Serveur ---
NODE_ENV=development
PORT=3000
# Origines autorisées (séparées par des virgules). Vide = toutes en dev, aucune en prod.
CORS_ORIGIN=

# --- Sessions ---
# Obligatoire en production : longue chaîne aléatoire.
JWT_SECRET=change-me-in-prod
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=180

# --- Envoi des codes de connexion ---
# console = code affiché dans les logs (dev) ; twilio = SMS / WhatsApp réels
OTP_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# --- Notifications push ---
# log = notifications seulement journalisées ; fcm = Firebase Cloud Messaging
PUSH_PROVIDER=log
# Contenu JSON du compte de service Firebase (sur une ligne)
FCM_SERVICE_ACCOUNT_JSON=

# --- Photos ---
# local = fichiers dans MEDIA_DIR servis sur /media ; s3 = stockage objet (Cloudflare R2, S3…)
STORAGE_DRIVER=local
MEDIA_DIR=./media
# URL publique des médias (ex. https://media.welly.ci). Vide = <hôte de l'API>/media
PUBLIC_MEDIA_BASE_URL=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Tests e2e (facultatif) ---
# Par défaut : DATABASE_URL ci-dessus, schéma isolé welly_test.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5434/welly_test
# TEST_DATABASE_SSL=false

# Derrière un proxy (Render, Fly, nginx…) : nombre de proxys de confiance, pour la vraie IP client
TRUST_PROXY=false
